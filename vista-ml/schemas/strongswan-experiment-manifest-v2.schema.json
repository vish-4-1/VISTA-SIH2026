{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vista.invalid/schemas/strongswan-experiment-manifest-v2.schema.json",
  "title": "VISTA StrongSwan Experiment Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "feature_schema_version",
    "extractor_version",
    "observations"
  ],
  "properties": {
    "manifest_version": {"const": "vista-strongswan-experiment-v2"},
    "dataset_id": {"type": "string", "minLength": 1},
    "feature_schema_version": {"const": "vista-flow-v1"},
    "extractor_version": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "session_id",
        "session_record_path",
        "session_record_sha256",
        "capture",
        "ground_truth",
        "workload",
        "vpn",
        "data_quality"
      ],
      "properties": {
        "experiment_id": {"type": "string", "format": "uuid"},
        "session_id": {"type": "string", "format": "uuid"},
        "session_record_path": {"$ref": "#/$defs/relative_path"},
        "session_record_sha256": {"$ref": "#/$defs/sha256"},
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "sha256",
            "started_at",
            "completed_at",
            "interface",
            "capture_point",
            "ip_version",
            "protocol_family",
            "raw_pcap_path",
            "raw_pcap_format",
            "raw_pcap_sha256",
            "raw_pcap_size_bytes"
          ],
          "properties": {
            "path": {"$ref": "#/$defs/relative_path"},
            "format": {"const": "packet_table_csv"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "string", "format": "date-time"},
            "interface": {"type": "string", "minLength": 1},
            "capture_point": {"enum": ["outer", "inner"]},
            "ip_version": {"const": 4},
            "protocol_family": {"const": "ESP"},
            "raw_pcap_path": {"$ref": "#/$defs/relative_path"},
            "raw_pcap_format": {"const": "pcap"},
            "raw_pcap_sha256": {"$ref": "#/$defs/sha256"},
            "raw_pcap_size_bytes": {"type": "integer", "minimum": 25}
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "record_path",
            "record_sha256",
            "record_field",
            "method",
            "independently_verified"
          ],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "label_schema_version": {"type": "string"},
            "workload_subtype": {"type": "string"},
            "record_path": {"$ref": "#/$defs/relative_path"},
            "record_sha256": {"$ref": "#/$defs/sha256"},
            "record_field": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "independently_verified": {"const": true}
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "configuration", "measurement_path", "measurement_sha256"],
          "properties": {
            "type": {"enum": ["icmpv4_echo", "tcp_marker", "http_traffic", "rtp_voip"]},
            "subtype": {"type": "string"},
            "configuration": {"type": "object"},
            "measurement_path": {"$ref": "#/$defs/relative_path"},
            "measurement_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "vpn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_configuration",
            "effective_configuration",
            "negotiated_sa_evidence_path",
            "negotiated_sa_evidence_sha256"
          ],
          "properties": {
            "requested_configuration": {"type": "object"},
            "effective_configuration": {"type": "object"},
            "negotiated_sa_evidence_path": {"$ref": "#/$defs/relative_path"},
            "negotiated_sa_evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "data_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": {"enum": ["accepted", "quarantined"]},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
